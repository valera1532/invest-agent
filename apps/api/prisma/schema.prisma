generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  passwordHash    String
  name            String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  aiDecisions     AiDecision[]
  aiPreviewJobs   AiPreviewJob[]
  investorQuestionnaire InvestorQuestionnaire?
  tradeExecutions TradeExecution[]
  sessions        Session[]
  investorProfile InvestorProfile?
  tbankConnection TbankConnection?
}

enum RiskProfile {
  CONSERVATIVE
  BALANCED
  GROWTH
  AGGRESSIVE
}

enum AiExecutionMode {
  MANUAL_APPROVAL
  FULL_AUTO
}

enum AiDecisionStatus {
  PROPOSED
  APPROVED
  REJECTED
  EXECUTED
  FAILED
}

enum TradeExecutionStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

enum AiPreviewJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum AgeRange {
  AGE_18_24
  AGE_25_34
  AGE_35_44
  AGE_45_54
  AGE_55_PLUS
}

enum ExperienceLevel {
  NONE
  UP_TO_ONE_YEAR
  ONE_TO_THREE_YEARS
  THREE_PLUS_YEARS
}

enum InvestmentGoal {
  CAPITAL_PRESERVATION
  PASSIVE_INCOME
  BALANCED_GROWTH
  FAST_GROWTH
}

enum InvestmentHorizon {
  LESS_THAN_ONE_YEAR
  ONE_TO_THREE_YEARS
  THREE_TO_FIVE_YEARS
  FIVE_PLUS_YEARS
}

enum LiquidityNeed {
  ANYTIME
  WITHIN_ONE_YEAR
  IN_SEVERAL_YEARS
  LONG_TERM_ONLY
}

enum DrawdownTolerance {
  UP_TO_10
  UP_TO_20
  UP_TO_30
  OVER_30
}

enum DrawdownReaction {
  REDUCE_POSITIONS
  HOLD_AND_WAIT
  BUY_MORE
}

enum RiskPriority {
  PROTECT_CAPITAL
  BALANCED_APPROACH
  MAXIMIZE_GROWTH
}

enum AiReviewFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  tokenHash    String   @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model TbankConnection {
  id             String   @id @default(cuid())
  userId         String   @unique
  tokenEncrypted String
  tokenMasked    String
  isValid        Boolean  @default(true)
  lastCheckedAt  DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InvestorProfile {
  id                 String      @id @default(cuid())
  userId             String      @unique
  primaryGoal        String      @default("Сформировать понятный инвестиционный портфель под цели пользователя")
  riskProfile        RiskProfile @default(BALANCED)
  telegram           String?
  dailyDigest        Boolean     @default(true)
  executionMode      AiExecutionMode @default(MANUAL_APPROVAL)
  aiReviewFrequency  AiReviewFrequency @default(DAILY)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InvestorQuestionnaire {
  id                  String             @id @default(cuid())
  userId              String             @unique
  ageRange            AgeRange
  experienceLevel     ExperienceLevel
  investmentGoal      InvestmentGoal
  investmentHorizon   InvestmentHorizon
  liquidityNeed       LiquidityNeed
  drawdownTolerance   DrawdownTolerance
  drawdownReaction    DrawdownReaction
  riskPriority        RiskPriority
  monthlyContribution Int
  aiReviewFrequency   AiReviewFrequency
  completedAt         DateTime           @default(now())
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AiDecision {
  id              String           @id @default(cuid())
  userId          String
  accountId       String?
  riskProfile     RiskProfile
  executionMode   AiExecutionMode
  status          AiDecisionStatus @default(PROPOSED)
  summary         String
  portfolioView   Json
  actions         Json
  futureBuyIdeas  Json?
  warnings        Json
  rejectedIdeas   Json
  runtimeContext  Json
  promptVersion   String           @default("v1")
  approvalNote    String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tradeExecutions TradeExecution[]

  @@index([userId, createdAt])
  @@index([userId, status])
}

model TradeExecution {
  id             String               @id @default(cuid())
  aiDecisionId   String
  userId         String
  status         TradeExecutionStatus @default(PENDING)
  actionType     String
  instrumentId   String
  accountId      String
  lots           Int
  brokerOrderId  String?
  brokerResponse Json?
  failureReason  String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  aiDecision     AiDecision           @relation(fields: [aiDecisionId], references: [id], onDelete: Cascade)
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([aiDecisionId])
  @@index([userId, createdAt])
}

model AiPreviewJob {
  id           String             @id @default(cuid())
  userId       String
  accountId    String?
  status       AiPreviewJobStatus @default(QUEUED)
  stage        String?
  errorMessage String?
  decisionId   String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  startedAt    DateTime?
  finishedAt   DateTime?
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, status])
}
