generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  passwordHash    String
  name            String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  aiDecisions     AiDecision[]
  aiPreviewJobs   AiPreviewJob[]
  tradeExecutions TradeExecution[]
  sessions        Session[]
  investorProfile InvestorProfile?
  tbankConnection TbankConnection?
}

enum RiskProfile {
  CONSERVATIVE
  BALANCED
  GROWTH
  AGGRESSIVE
}

enum AiExecutionMode {
  MANUAL_APPROVAL
  FULL_AUTO
}

enum AiDecisionStatus {
  PROPOSED
  APPROVED
  REJECTED
  EXECUTED
  FAILED
}

enum TradeExecutionStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

enum AiPreviewJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  tokenHash    String   @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model TbankConnection {
  id             String   @id @default(cuid())
  userId         String   @unique
  tokenEncrypted String
  tokenMasked    String
  isValid        Boolean  @default(true)
  lastCheckedAt  DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InvestorProfile {
  id                 String      @id @default(cuid())
  userId             String      @unique
  primaryGoal        String      @default("Сформировать понятный инвестиционный портфель под цели пользователя")
  riskProfile        RiskProfile @default(BALANCED)
  telegram           String?
  dailyDigest        Boolean     @default(true)
  executionMode      AiExecutionMode @default(MANUAL_APPROVAL)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AiDecision {
  id              String           @id @default(cuid())
  userId          String
  accountId       String?
  riskProfile     RiskProfile
  executionMode   AiExecutionMode
  status          AiDecisionStatus @default(PROPOSED)
  summary         String
  portfolioView   Json
  actions         Json
  futureBuyIdeas  Json?
  warnings        Json
  rejectedIdeas   Json
  runtimeContext  Json
  promptVersion   String           @default("v1")
  approvalNote    String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tradeExecutions TradeExecution[]

  @@index([userId, createdAt])
  @@index([userId, status])
}

model TradeExecution {
  id             String               @id @default(cuid())
  aiDecisionId   String
  userId         String
  status         TradeExecutionStatus @default(PENDING)
  actionType     String
  instrumentId   String
  accountId      String
  lots           Int
  brokerOrderId  String?
  brokerResponse Json?
  failureReason  String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  aiDecision     AiDecision           @relation(fields: [aiDecisionId], references: [id], onDelete: Cascade)
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([aiDecisionId])
  @@index([userId, createdAt])
}

model AiPreviewJob {
  id           String             @id @default(cuid())
  userId       String
  accountId    String?
  status       AiPreviewJobStatus @default(QUEUED)
  stage        String?
  errorMessage String?
  decisionId   String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  startedAt    DateTime?
  finishedAt   DateTime?
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, status])
}
